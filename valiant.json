{
  "gates": [
    {
      "name": "unit-tests",
      "cmd": [
        "python3",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-q"
      ],
      "expectStderr": true
    }
  ],
  "ledger": false,
  "guards": [
    {
      "name": "site-verification-link",
      "file": "web/index.html",
      "find": "<a href=\"https://morpheus.nz/verification\">",
      "replace": "<a href=\"#\">",
      "check": [
        "python3",
        "scripts/check-site-links.py"
      ]
    },
    {
      "name": "site-honest-line",
      "file": "web/index.html",
      "find": "seeking design partners",
      "replace": "seeking customers",
      "check": [
        "python3",
        "scripts/check-site-links.py"
      ]
    }
  ]
}
