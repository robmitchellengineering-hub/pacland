{
  "gates": [
    {
      "name": "unit-tests",
      "cmd": [
        "sh",
        "scripts/run-tests.sh"
      ],
      "expectStderr": true
    },
    {
      "name": "conservation-gate",
      "expectStderr": true,
      "cmd": [
        "sh",
        "-c",
        "PYTHONPATH=src python3 -m unittest tests.test_climate_cmip6_drift -q"
      ]
    },
    {
      "name": "reference-model-gate",
      "expectStderr": true,
      "cmd": [
        "sh",
        "-c",
        "PYTHONPATH=src python3 -m unittest tests.test_climate_reference_model -q"
      ]
    }
  ],
  "ledger": false,
  "guards": [
    {
      "name": "site-verification-link",
      "file": "web/index.html",
      "find": "<a href=\"https://vvs.morpheus.nz\">Valiant Verification Systems &rarr;</a>",
      "replace": "<a href=\"#\">Valiant Verification Systems &rarr;</a>",
      "check": [
        "python3",
        "scripts/check-site-links.py"
      ]
    },
    {
      "name": "site-honest-line",
      "file": "web/index.html",
      "find": "seeking design partners",
      "replace": "seeking customers",
      "check": [
        "python3",
        "scripts/check-site-links.py"
      ]
    },
    {
      "name": "conservation-unit-scale",
      "file": "src/pacland/climate/cmip6_drift.py",
      "find": "_EARTH_AREA_M2 = 5.101e14",
      "replace": "_EARTH_AREA_M2 = 5.101e8",
      "check": [
        "sh",
        "-c",
        "PYTHONPATH=src python3 -m unittest tests.test_climate_cmip6_drift tests.test_climate_reference_model -q"
      ]
    },
    {
      "name": "worst-energy-offender-zeroed",
      "file": "data/climate/cmip6_drift.json",
      "find": "\"netTOA_J_per_yr\": 2.39e+22",
      "replace": "\"netTOA_J_per_yr\": 0.0",
      "check": [
        "sh",
        "-c",
        "PYTHONPATH=src python3 -m unittest tests.test_climate_cmip6_drift tests.test_climate_reference_model -q"
      ]
    },
    {
      "name": "giss-ecs-out-of-range",
      "file": "data/climate/cmip6_ecs.json",
      "find": "\"GISS-E2-1-G\": 2.71",
      "replace": "\"GISS-E2-1-G\": 4.2",
      "check": [
        "sh",
        "-c",
        "PYTHONPATH=src python3 -m unittest tests.test_climate_cmip6_drift tests.test_climate_reference_model -q"
      ]
    },
    {
      "name": "giss-erf2x-out-of-band",
      "file": "data/climate/cmip6_ecs.json",
      "find": "\"GISS-E2-1-G\": 3.95",
      "replace": "\"GISS-E2-1-G\": 5.0",
      "check": [
        "sh",
        "-c",
        "PYTHONPATH=src python3 -m unittest tests.test_climate_cmip6_drift tests.test_climate_reference_model -q"
      ]
    },
    {
      "name": "exactness-f-term-covariant",
      "file": "src/pacland/oracle/potential_t6.py",
      "find": "return np.array([dw[i] + kg[i] * w for i in range(N_MODULI)])",
      "replace": "return np.array([dw[i] + kg[i] * 0.0 * w for i in range(N_MODULI)])",
      "check": [
        "sh",
        "-c",
        "PYTHONPATH=src python3 -m unittest tests.test_exactness -q"
      ]
    },
    {
      "name": "exactness-split-flux-order",
      "file": "src/pacland/exactness/identities.py",
      "find": "return v[:half], v[half:]",
      "replace": "return v[half:], v[:half]",
      "check": [
        "sh",
        "-c",
        "PYTHONPATH=src python3 -m unittest tests.test_exactness -q"
      ]
    }
  ]
}