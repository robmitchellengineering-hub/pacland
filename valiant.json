{
  "gates": [
    {
      "name": "unit-tests",
      "cmd": [
        "sh",
        "scripts/run-tests.sh"
      ],
      "expectStderr": true
    }
  ],
  "ledger": false,
  "guards": [
    {
      "name": "site-verification-link",
      "file": "web/index.html",
      "find": "<a href=\"https://vvs.morpheus.nz\">Valiant Verification Systems &rarr;</a>",
      "replace": "<a href=\"#\">Valiant Verification Systems &rarr;</a>",
      "check": [
        "python3",
        "scripts/check-site-links.py"
      ]
    },
    {
      "name": "site-honest-line",
      "file": "web/index.html",
      "find": "seeking design partners",
      "replace": "seeking customers",
      "check": [
        "python3",
        "scripts/check-site-links.py"
      ]
    }
  ]
}
