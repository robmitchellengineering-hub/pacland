/-!
# Degree-3 slice of the FFT (n = 1) — no cubic invariant

The invariant ring `ℂ[N]` is generated by the quadratic tadpole, so there is
**no degree-3 invariant**. Proved here for n = 1 (the flux pair `(F,H)` is a
4-vector): the dilation `diag(2, 1/2, 2, 1/2)` scales every degree-3 monomial by
`2^odd ≠ 1`, so no cubic trilinear form is invariant under it.
-/

open Matrix
noncomputable section
namespace DegreeThree

/-- The dilation `diag(2, 1/2, 2, 1/2)` acting on the flux pair `(F, H) ≃ Fin 4`:
entries 0 and 2 (the `F₁, H₁` slots) scale by 2, entries 1 and 3 by 1/2. -/
def dil (i : Fin 4) : ℚ := if i.val % 2 = 0 then 2 else (1 / 2 : ℚ)

/-- **Degree-3 slice of the FFT (n = 1)**: no non-zero trilinear form is invariant
under the dilation, so the invariant ring has no cubic piece. The dilation scales
each degree-3 monomial by `2^odd ≠ 1`, killing every component. -/
theorem no_cubic_invariant (T : Fin 4 → Fin 4 → Fin 4 → ℚ)
    (h : ∀ i j k, dil i * dil j * dil k * T i j k = T i j k) :
    T = 0 := by
  funext i j k
  have hijk := h i j k
  have hfac : (dil i * dil j * dil k - 1) * T i j k = 0 := by
    have h' := congrArg (fun x : ℚ => x - T i j k) hijk
    ring_nf at h'
    exact h'
  have hne : dil i * dil j * dil k - 1 ≠ 0 := by
    fin_cases i <;> fin_cases j <;> fin_cases k <;> norm_num [dil]
  exact (mul_eq_zero.mp hfac).resolve_left hne

end DegreeThree
end
