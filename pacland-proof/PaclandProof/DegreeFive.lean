/-!
# Degree-5 slice of the FFT (n = 1) — no quintic invariant

The invariant ring `ℂ[N]` is generated by the quadratic tadpole, so there is
**no degree-5 invariant**. Proved here for n = 1 (the flux pair `(F,H)` is a
4-vector): the dilation `diag(2, 1/2, 2, 1/2)` scales every degree-5 monomial by
`2^odd ≠ 1` (five factors, each `2` or `1/2`, so the product is `2^(2m−5)` for
`m ∈ 0..5`, which is an odd power of 2 and never 1), so no quintic form is
invariant under it.
-/

open Matrix
noncomputable section
namespace DegreeFive

/-- The dilation `diag(2, 1/2, 2, 1/2)` acting on the flux pair `(F, H) ≃ Fin 4`:
entries 0 and 2 (the `F₁, H₁` slots) scale by 2, entries 1 and 3 by 1/2. -/
def dil (i : Fin 4) : ℚ := if i.val % 2 = 0 then 2 else (1 / 2 : ℚ)

set_option maxHeartbeats 2000000 in
/-- **Degree-5 slice of the FFT (n = 1)**: no non-zero quintic form is invariant
under the dilation, so the invariant ring has no degree-5 piece. The dilation
scales each degree-5 monomial by `2^odd ≠ 1`, killing every component. -/
theorem no_quintic_invariant (T : Fin 4 → Fin 4 → Fin 4 → Fin 4 → Fin 4 → ℚ)
    (h : ∀ i j k l m, dil i * dil j * dil k * dil l * dil m * T i j k l m = T i j k l m) :
    T = 0 := by
  funext i j k l m
  have hijk := h i j k l m
  have hfac : (dil i * dil j * dil k * dil l * dil m - 1) * T i j k l m = 0 := by
    have h' := congrArg (fun x : ℚ => x - T i j k l m) hijk
    ring_nf at h'
    ring_nf
    exact h'
  have hne : dil i * dil j * dil k * dil l * dil m - 1 ≠ 0 := by
    fin_cases i <;> fin_cases j <;> fin_cases k <;> fin_cases l <;> fin_cases m <;>
      norm_num [dil]
  exact (mul_eq_zero.mp hfac).resolve_left hne

end DegreeFive
end
