def subject_enterprise_is_unlimited : String := "// Licence verification — offline, signature-based, no phone-home.\n//\n// WHY OFFLINE. A paid verification tool that needs a network round trip to start is unusable on the\n// machines this thing is FOR: CI runners, air-gapped build boxes, a customer's laptop on a train. It\n// also puts Morpheus's uptime in the path of somebody else's build. So the licence carries its own\n// proof: a small JSON payload, Ed25519-signed by Morpheus, verified here with a public key. Nothing\n// is sent, nothing is stored beyond the key itself.\n//\n// WHAT THIS CANNOT DO, stated plainly: it cannot un-issue. Offline verification has no idea whether a\n// licence was refunded five minutes ago. That gap is closed by SHORT EXPIRY + renewal rather than by\n// a check-in — the same shape Morpheus's own broker tokens use (7-day tokens, re-minted before they\n// expire). A caller may also pass a `revoked` set (kid list) for the case where a key is known bad.\n//\n// THE FORMAT, which is the contract the server mints to:\n//\n//     vvs1.<base64url(payload JSON)>.<base64url(ed25519 signature)>\n//\n// payload: { \"v\": 1, \"sub\": \"<morpheus account id>\", \"plan\": \"solo\"|\"team\", \"seats\": 1, \"iat\": <unix>,\n//            \"exp\": <unix>, \"kid\": \"<key id>\", \"jti\": \"<licence id>\" }\n//\n// `kid` names which signing key made it, so a key rotation does not invalidate everything at once.\nimport { createPublicKey, verify as cryptoVerify } from \"node:crypto\";\n\nconst PREFIX = \"vvs1\";\nconst PLANS = [\"solo\", \"team\", \"enterprise\"];\n\n// WHAT A TIER MEANS. Seats are the only real difference today, and that is stated rather than implied:\n// every plan gets the whole tool, because a licence that unlocks a partial product teaches a customer\n// that the product is partial. ENTERPRISE is unlimited seats (`seats: 0` means \"no seat count\").\nconst PLAN_SEATS = { solo: 1, team: 5, enterprise: 0 };\n\n/** base64url without padding, either way round. */\nfunction b64urlToBuf(s) {\n  return Buffer.from(s.replace(/-/g, \"+\").replace(/_/g, \"/\"), \"base64\");\n}\n\n/**\n * Verify a licence string.\n *\n * @param {string} licence  the vvs1.… string the customer pasted\n * @param {object} opts\n * @param {string} opts.publicKeyPem  PEM Ed25519 public key (or a map keyed by `kid` for rotation)\n * @param {number} [opts.now]         unix seconds; injectable so tests are not clock-dependent\n * @param {number} [opts.graceDays]   how long an expired licence still works (default 0 — expiry is expiry)\n * @param {Set<string>} [opts.revoked] licence ids (jti) known bad\n * @returns {{ok: boolean, reason?: string, claims?: object}}\n */\nexport function verifyLicence(licence, { publicKeyPem, now = Math.floor(Date.now() / 1000), graceDays = 0, revoked } = {}) {\n  if (typeof licence !== \"string\" || !licence.trim()) return { ok: false, reason: \"no licence given\" };\n  const parts = licence.trim().split(\".\");\n  if (parts.length !== 3) return { ok: false, reason: \"not a licence: expected vvs1.<payload>.<signature>\" };\n  const [prefix, payloadPart, sigPart] = parts;\n  if (prefix !== PREFIX) return { ok: false, reason: `unknown licence version \"${prefix}\" (this build reads ${PREFIX})` };\n\n  let claims;\n  try {\n    claims = JSON.parse(b64urlToBuf(payloadPart).toString(\"utf8\"));\n  } catch {\n    return { ok: false, reason: \"the payload is not readable JSON — the key was probably truncated when copied\" };\n  }\n  if (claims?.v !== 1) return { ok: false, reason: `unsupported payload version ${JSON.stringify(claims?.v)}` };\n  // TWO TOKEN TYPES, ONE SIGNATURE. A revocation list is the second: same vvs1 envelope, same key, no plan and no account,\n  // because it grants nothing — it only withdraws. It is checked as strictly (version, expiry, signature, a real array) and\n  // cannot be mistaken for a licence: `kind` decides which checks apply, and a licence must never carry `kind`.\n  const isRevocationList = claims.kind === \"revocations\";\n  if (isRevocationList) {\n    if (!Array.isArray(claims.revocations)) return { ok: false, reason: \"a revocation list has no revocations array\" };\n    if (!Number.isInteger(claims.exp)) return { ok: false, reason: \"a revocation list has no expiry\" };\n  } else {\n    if (!PLANS.includes(claims.plan)) return { ok: false, reason: `unknown plan ${JSON.stringify(claims.plan)}` };\n    if (typeof claims.sub !== \"string\" || !claims.sub) return { ok: false, reason: \"licence names no account\" };\n    if (!Number.isInteger(claims.exp)) return { ok: false, reason: \"licence has no expiry\" };\n  }\n\n  if (revoked && claims.jti && revoked.has(claims.jti)) {\n    return { ok: false, reason: `licence ${claims.jti} has been revoked` };\n  }\n\n  // Resolve the key: a single PEM, or { kid: pem } for rotation. A licence naming a kid we do not\n  // have is a DIFFERENT failure from a bad signature, and saying which one saves the customer a\n  // support round trip.\n  let pem = publicKeyPem;\n  if (pem && typeof pem === \"object\") {\n    if (!claims.kid) return { ok: false, reason: \"this build has several signing keys but the licence names no key id (kid)\" };\n    pem = pem[claims.kid];\n    if (!pem) return { ok: false, reason: `licence was signed with key \"${claims.kid}\", which this build does not carry — update the tool` };\n  }\n  if (!pem) return { ok: false, reason: \"no public key to verify against (this build is misconfigured)\" };\n\n  // The signature covers the payload BYTES AS RECEIVED, not a re-serialisation — so a server that\n  // changes its JSON key order does not silently invalidate every outstanding licence.\n  let okSignature = false;\n  try {\n    okSignature = cryptoVerify(null, b64urlToBuf(payloadPart), createPublicKey(pem), b64urlToBuf(sigPart));\n  } catch (e) {\n    return { ok: false, reason: `could not check the signature: ${e.message}` };\n  }\n  if (!okSignature) return { ok: false, reason: \"the signature does not match this licence — it was edited, or it came from another issuer\" };\n\n  const graceSeconds = Math.max(0, graceDays) * 86400;\n  if (now > claims.exp + graceSeconds) {\n    const days = Math.round((now - claims.exp) / 86400);\n    return { ok: false, reason: `licence expired ${days} day(s) ago — renew it at morpheus.nz`, claims };\n  }\n\n  return { ok: true, claims };\n}\n\n/** Human-readable line for the CLI. Never prints the licence itself. */\nexport function describeLicence(claims) {\n  const exp = new Date(claims.exp * 1000).toISOString().slice(0, 10);\n  const seats = claims.seats ?? PLAN_SEATS[claims.plan] ?? 1;\n  const seatText = seats === 0 ? \"unlimited seats\" : `${seats} seat(s)`;\n  return `${claims.plan} plan · account ${String(claims.sub).slice(0, 8)}… · ${seatText} · expires ${exp}`;\n}\n\nexport { PLANS, PLAN_SEATS, PREFIX };\n"

