# OS cruft
.DS_Store
Thumbs.db

# Python (likely future oracle/tooling)
__pycache__/
*.pyc
.venv/
venv/

# Local toolchain (GMP etc. built from source)
.toolchain/

# Node (possible future tooling)
node_modules/

# Local env / secrets
.env
.env.*
!.env.example
dist/
*.egg-info/
data/discoveries/

# SEXTANT runner local state (discoveries/verdicts are regenerated per run)
runs/

# the prove loop writes its temp proposal here
pacland-proof/.prove/

# Runtime build evidence (regenerated by --validate; the derived summary is in frontier-view.json)
web/build-evidence.json

# PyInstaller build artifacts
build/
dist/
*.spec
